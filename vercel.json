{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/check-replies",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/wa-verify",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/web-capture",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/email-discovery",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/fila-envio",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/fila-wa",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/motor-agente",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/destilador",
      "schedule": "20 6 * * *"
    }
  ]
}
